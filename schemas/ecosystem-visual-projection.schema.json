{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/ecosystem-visual-projection.schema.json",
  "title": "StegVerse Ecosystem Visual Projection",
  "type": "object",
  "required": ["schema", "projection_id", "source_event_ids", "nodes", "edges", "provenance", "authority"],
  "properties": {
    "schema": { "const": "stegverse.ecosystem_visual_projection/v1" },
    "projection_id": { "type": "string", "minLength": 1 },
    "source_event_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "source_event_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["event", "entity", "constraint", "decision", "evidence", "artifact", "policy", "continuity"] },
          "label": { "type": "string" },
          "source_event_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "state": { "type": ["string", "null"] },
          "refs": { "type": "array", "items": { "type": "string" } },
          "presentation": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "relation", "source_event_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "source_event_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["2d", "2.5d", "3d", "auto"] },
        "layout": { "type": "string" },
        "focus_node_id": { "type": ["string", "null"] },
        "animate": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["canonical_stream", "generated_from_exact_events"],
      "properties": {
        "canonical_stream": { "type": "string", "minLength": 1 },
        "generated_from_exact_events": { "const": true },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "policy_refs": { "type": "array", "items": { "type": "string" } },
        "artifact_refs": { "type": "array", "items": { "type": "string" } },
        "continuity_refs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["renderer_may_mutate_canonical_events", "renderer_may_grant_admission", "renderer_may_invent_evidence"],
      "properties": {
        "renderer_may_mutate_canonical_events": { "const": false },
        "renderer_may_grant_admission": { "const": false },
        "renderer_may_invent_evidence": { "const": false },
        "renderer_role": { "const": "PROJECTION_ONLY" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
