{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/Site/schemas/hil_master_record_release.schema.json",
  "title": "HIL Master Record Release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "experiment_id",
    "primary",
    "response",
    "receiver_receipt",
    "private_review",
    "publication",
    "previous_release_sha256",
    "release_payload_sha256",
    "created_at",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "HIL-MASTER-RECORD-RELEASE-v1"},
    "release_id": {"type": "string", "pattern": "^HIL-MR-[A-Z0-9._-]+$"},
    "experiment_id": {"const": "HIL-2026"},
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "prompt_sha256"],
      "properties": {
        "version": {"const": "v1.1"},
        "sha256": {"const": "a7b1c62e336b4e244ecf7fdcd10af195401f6c44328de32615b073d2a5c3c462"},
        "prompt_sha256": {"const": "cdff8d2266bb3eefbb6e5d28d9adc548e6c8dfc039debd72fe404f1d0249912c"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_id", "sha256", "public_index_path"],
      "properties": {
        "response_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "public_index_path": {"const": "data/hil-responses.json"}
      }
    },
    "receiver_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "submitted_file_sha256", "chain_validation_state"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "submitted_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chain_validation_state": {"const": "VERIFIED"}
      }
    },
    "private_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "decision_receipt_id", "authenticated"],
      "properties": {
        "decision": {"const": "ACCEPT_PRIVATE"},
        "decision_receipt_id": {"type": "string", "minLength": 1},
        "authenticated": {"const": true}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_receipt_id", "append_only", "authenticated"],
      "properties": {
        "publication_receipt_id": {"type": "string", "minLength": 1},
        "append_only": {"const": true},
        "authenticated": {"const": true}
      }
    },
    "previous_release_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "release_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["custody", "execution", "publication_mutation", "endorsement", "scientific_proof"],
      "properties": {
        "custody": {"const": false},
        "execution": {"const": false},
        "publication_mutation": {"const": false},
        "endorsement": {"const": false},
        "scientific_proof": {"const": false}
      }
    }
  }
}
