{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/hil-semantic-transformation.schema.json",
  "title": "HIL Semantic Transformation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_type",
    "schema_version",
    "source_record_id",
    "output_record_id",
    "interoperability_layer",
    "source_claim_class",
    "output_claim_class",
    "source_boundary",
    "output_boundary",
    "transformation_classes",
    "evidence_refs",
    "authority_effect"
  ],
  "properties": {
    "receipt_type": {"const": "HIL_SEMANTIC_TRANSFORMATION"},
    "schema_version": {"const": "HIL-SEMANTIC-TRANSFORMATION-v1"},
    "source_record_id": {"type": "string", "minLength": 1},
    "output_record_id": {"type": "string", "minLength": 1},
    "interoperability_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "identity", "version"],
      "properties": {
        "class": {"enum": ["human", "llm", "institution", "journalistic", "legal", "scientific", "technical", "other"]},
        "identity": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      }
    },
    "source_claim_class": {"enum": ["observation", "hypothesis", "inference", "conclusion", "analogy", "compatibility", "conjecture", "axiom", "definition", "established_external_result", "other"]},
    "output_claim_class": {"enum": ["observation", "hypothesis", "inference", "conclusion", "analogy", "compatibility", "conjecture", "axiom", "definition", "established_external_result", "other"]},
    "source_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "output_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "source_boundary": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output_boundary": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "identity_refs_preserved": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "identity_refs_changed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "constraints_preserved": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "constraints_removed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "constraints_added": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "transformation_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["none", "observation_to_belief", "hypothesis_to_assertion", "probability_to_certainty", "probability_to_dismissal", "boundary_narrowing", "boundary_broadening", "investigation_to_proof_demand", "uncertainty_to_overconfidence", "source_identity_substitution", "state_to_trajectory_claim", "compatibility_to_confirmation", "analogy_to_evidence", "other"]}
    },
    "semantic_preservation_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "confidence_preservation_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "boundary_preservation_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "identity_preservation_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "reconstruction_fidelity_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "measurement_method_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "authority_effect": {"const": false}
  }
}
