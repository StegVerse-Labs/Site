{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://stegverse.org/schemas/hil-pilot-comparison.schema.json",
  "title":"HIL Governed Pilot Comparison",
  "type":"object","additionalProperties":false,
  "required":["schema_version","comparison_id","generated_at","canonical_primary","canonical_prompt","rubric","responses","comparisons","limitations","claims_withheld","authority_effect","publication_effect"],
  "properties":{
    "schema_version":{"const":"HIL-PILOT-COMPARISON-v1"},
    "comparison_id":{"type":"string","pattern":"^HIL-COMP-[A-Z0-9-]+$"},
    "generated_at":{"type":"string","format":"date-time"},
    "canonical_primary":{"$ref":"#/$defs/identity"},"canonical_prompt":{"$ref":"#/$defs/identity"},
    "rubric":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["criterion_id","description","scale"],"properties":{"criterion_id":{"type":"string"},"description":{"type":"string"},"scale":{"type":"array","minItems":2,"items":{"type":"string"}}}}},
    "responses":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["submission_id","model","provider","response_sha256","verification_status"],"properties":{"submission_id":{"type":"string"},"model":{"type":"string"},"provider":{"type":"string"},"response_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"verification_status":{"const":"RETURN_PACKAGE_VERIFIED"}}}},
    "comparisons":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["criterion_id","observations","agreement","disagreement","uncertainty"],"properties":{"criterion_id":{"type":"string"},"observations":{"type":"array","items":{"type":"object"}},"agreement":{"type":"array","items":{"type":"string"}},"disagreement":{"type":"array","items":{"type":"string"}},"uncertainty":{"type":"array","items":{"type":"string"}}}}},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string"}},
    "claims_withheld":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "authority_effect":{"const":false},"publication_effect":{"const":false}
  },
  "$defs":{"identity":{"type":"object","additionalProperties":false,"required":["version","sha256"],"properties":{"version":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}
}
