{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/va-claim-assistant/private-document-intake.schema.json",
  "title": "VA Claim Assistant Private Document Intake",
  "type": "object",
  "required": ["schema_version", "session_id", "documents", "consent", "retention", "authority_flags"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "filename", "sha256", "media_type", "privacy_class", "page_count", "source_kind"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"enum": ["application/pdf", "image/png", "image/jpeg", "text/plain"]},
          "privacy_class": {"enum": ["PERSONAL", "SENSITIVE_HEALTH", "HIGHLY_SENSITIVE"]},
          "page_count": {"type": "integer", "minimum": 1},
          "source_kind": {"enum": ["VA_RECORD", "SERVICE_RECORD", "PRIVATE_MEDICAL", "LAY_STATEMENT", "EMPLOYMENT_RECORD", "PRIOR_DECISION", "OTHER"]},
          "condition_associations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "consent": {
      "type": "object",
      "required": ["user_confirmed_authority_to_submit", "user_confirmed_private_processing", "user_confirmed_no_emergency_use"],
      "properties": {
        "user_confirmed_authority_to_submit": {"const": true},
        "user_confirmed_private_processing": {"const": true},
        "user_confirmed_no_emergency_use": {"const": true}
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": ["mode", "raw_document_retention", "derived_record_retention"],
      "properties": {
        "mode": {"enum": ["USER_CONTROLLED", "SESSION_SCOPED"]},
        "raw_document_retention": {"enum": ["NOT_RETAINED", "SESSION_ONLY", "USER_CONTROLLED"]},
        "derived_record_retention": {"enum": ["CUSTODY_RECEIPT_ONLY", "USER_CONTROLLED"]}
      },
      "additionalProperties": false
    },
    "authority_flags": {
      "type": "object",
      "required": ["adjudication", "representation", "medical_opinion", "rating", "execution", "publication"],
      "properties": {
        "adjudication": {"const": false},
        "representation": {"const": false},
        "medical_opinion": {"const": false},
        "rating": {"const": false},
        "execution": {"const": false},
        "publication": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
