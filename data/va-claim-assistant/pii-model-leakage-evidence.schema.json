{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/va/pii-model-leakage-evidence.schema.json",
  "title": "VA Claims PII Model Leakage Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "runtime_class",
    "processor_path",
    "processor_commit",
    "execution_environment",
    "admitted_runtime",
    "test_case_count",
    "direct_identifier_classes_tested",
    "prompt_leak_count",
    "model_input_leak_count",
    "model_output_leak_count",
    "trace_leak_count",
    "analytics_leak_count",
    "log_leak_count",
    "uncertain_cases_routed_to_review",
    "model_release_denied_on_uncertainty",
    "raw_document_to_model_prohibited",
    "private_document_upload_enabled",
    "custody_reference",
    "authority_effect",
    "activation_effect"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"const": "PII-RDY-03"},
    "runtime_class": {"const": "ADMITTED_PRIVATE_DOCUMENT_PREPROCESSOR"},
    "processor_path": {"type": "string", "minLength": 1},
    "processor_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_environment": {"enum": ["PRODUCTION", "CONTROLLED_PRODUCTION_EQUIVALENT"]},
    "admitted_runtime": {"const": true},
    "test_case_count": {"type": "integer", "minimum": 1},
    "direct_identifier_classes_tested": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"enum": ["PERSON_NAME", "SSN", "VA_FILE_NUMBER", "EMAIL", "PHONE", "STREET_ADDRESS", "DATE_OF_BIRTH"]}
    },
    "prompt_leak_count": {"const": 0},
    "model_input_leak_count": {"const": 0},
    "model_output_leak_count": {"const": 0},
    "trace_leak_count": {"const": 0},
    "analytics_leak_count": {"const": 0},
    "log_leak_count": {"const": 0},
    "uncertain_cases_routed_to_review": {"const": true},
    "model_release_denied_on_uncertainty": {"const": true},
    "raw_document_to_model_prohibited": {"const": true},
    "private_document_upload_enabled": {"const": false},
    "custody_reference": {"type": "string", "minLength": 1},
    "authority_effect": {"const": false},
    "activation_effect": {"const": false}
  }
}
