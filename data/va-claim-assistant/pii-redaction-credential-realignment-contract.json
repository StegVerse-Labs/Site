{
  "schema_version": "1.0.0",
  "contract_id": "SV-VA-PII-REALIGNMENT-001",
  "originating_requirement": "documents submitted through VA Claims Chat are stripped of PII before model-facing processing and realigned with veteran identity only after a verified credentialing handoff",
  "scope": [
    "private_document_intake",
    "document_processing",
    "claims_chat_context",
    "review_packet",
    "filing_package"
  ],
  "policy": {
    "federal_privacy_controls_are_minimum": true,
    "stegverse_must_exceed_minimum": true,
    "raw_pii_to_llm_adapter_prohibited": true,
    "raw_pii_to_public_surface_prohibited": true,
    "identity_reassociation_requires_verified_credentialing_handoff": true,
    "reassociation_before_credentialing_prohibited": true,
    "missing_or_expired_credentialing_state": "BLOCKED",
    "authority_effect": false,
    "activation_effect": false
  },
  "zones": {
    "credentialing_vault": {
      "holds": [
        "verified veteran identity",
        "identity-proofing evidence references",
        "credential assurance level",
        "authentication and federation receipts",
        "revocation and expiry state"
      ],
      "must_not_hold": [
        "model prompts",
        "model outputs",
        "unredacted document content except separately admitted identity evidence"
      ]
    },
    "document_privacy_zone": {
      "holds": [
        "encrypted raw upload for bounded preprocessing",
        "document hash",
        "PII detection map",
        "redaction manifest",
        "pseudonymous document token",
        "redacted working copy"
      ],
      "must_not_emit": [
        "direct identifiers",
        "credential secrets",
        "raw identity evidence",
        "unredacted document bytes"
      ]
    },
    "claims_reasoning_zone": {
      "accepts_only": [
        "redacted working copy",
        "pseudonymous document token",
        "page anchors",
        "sanitized derived facts",
        "contradictions",
        "missing evidence",
        "separately labeled inference"
      ],
      "must_not_receive": [
        "name",
        "social security number",
        "VA file number",
        "date of birth unless indispensable and separately tokenized",
        "address",
        "telephone number",
        "email address",
        "credential secret",
        "raw identity-proofing artifact"
      ]
    },
    "identity_linkage_zone": {
      "purpose": "bind an approved derived record, review packet, or exact filing package to the verified veteran after credentialing",
      "accepts_only": [
        "verified credentialing handoff receipt",
        "pseudonymous document token",
        "derived record or package hash",
        "veteran identity reference token",
        "purpose and scope",
        "expiry",
        "revocation state"
      ],
      "must_not_restore_pii_into": [
        "LLM prompts",
        "LLM outputs",
        "analytics",
        "logs",
        "public surfaces"
      ]
    }
  },
  "pii_classes": [
    "full name",
    "social security number",
    "VA file number",
    "date and place of birth",
    "address",
    "telephone number",
    "email address",
    "account and financial identifiers",
    "medical record number",
    "beneficiary identifiers",
    "signature and biometric identifiers",
    "device and network identifiers when linkable",
    "other information linkable to a specific veteran"
  ],
  "processing_sequence": [
    "upload encrypted into document privacy zone",
    "malware and active-content scan",
    "hash original bytes",
    "detect and classify PII and PHI",
    "create cryptographically bound redaction manifest",
    "replace identifiers with purpose-limited pseudonymous tokens",
    "verify no prohibited identifier remains in model-facing copy",
    "process only the redacted copy in the claims reasoning zone",
    "produce sanitized derived record and provenance",
    "complete credentialing handoff through the credentialing vault",
    "issue scoped identity-linkage receipt",
    "bind only the approved derived record or exact package hash to veteran identity reference",
    "retain custody, access, deletion, revocation, and reconstruction receipts"
  ],
  "redaction_manifest_required_fields": [
    "original_document_sha256",
    "redacted_document_sha256",
    "pseudonymous_document_token",
    "detected_pii_classes",
    "redaction_count",
    "page_and_region_anchors",
    "detector_version",
    "review_state",
    "created_at",
    "retention_expiry",
    "manifest_sha256"
  ],
  "credentialing_handoff_required_fields": [
    "handoff_id",
    "veteran_identity_reference_token",
    "identity_proofing_assurance",
    "authentication_assurance",
    "federation_assurance_if_used",
    "credential_status",
    "issued_at",
    "expires_at",
    "revocation_reference",
    "authorized_purposes",
    "handoff_sha256"
  ],
  "identity_linkage_receipt_required_fields": [
    "linkage_id",
    "credentialing_handoff_id",
    "pseudonymous_document_token",
    "derived_record_or_package_sha256",
    "veteran_identity_reference_token",
    "purpose",
    "scope",
    "issued_at",
    "expires_at",
    "revocation_reference",
    "linkage_sha256"
  ],
  "release_gates": [
    "PII detector and redactor tests pass",
    "false-negative and false-positive thresholds approved",
    "manual review path exists for uncertain redactions",
    "model-facing PII leakage tests pass",
    "credentialing handoff validation passes",
    "linkage is purpose-limited and expiring",
    "revocation prevents future identity linkage",
    "raw documents never leave the privacy zone",
    "logs and analytics contain no direct identifiers",
    "custody and reconstruction pass",
    "deletion removes raw and redacted copies according to policy while preserving non-identifying receipts",
    "independent privacy and security assessment retained",
    "no unresolved high or critical findings"
  ],
  "fail_closed_states": [
    "PII_DETECTION_UNCERTAIN_REVIEW_REQUIRED",
    "REDACTION_VERIFICATION_FAILED",
    "CREDENTIALING_HANDOFF_MISSING",
    "CREDENTIALING_HANDOFF_EXPIRED",
    "CREDENTIALING_HANDOFF_REVOKED",
    "LINKAGE_SCOPE_MISMATCH",
    "PACKAGE_HASH_MISMATCH",
    "DELETION_OR_CUSTODY_EVIDENCE_MISSING"
  ],
  "prohibited_actions": [
    "send raw documents or direct identifiers to the LLM adapter",
    "restore PII into model prompts or outputs",
    "link a document to a veteran before credentialing succeeds",
    "reuse identity linkage for an unapproved purpose",
    "retain a permanent cross-context tracking identifier",
    "publish a redaction map or identity-linkage secret",
    "treat pseudonymization as anonymization",
    "claim VA, NIST, FISMA, FedRAMP, HIPAA, or federal compliance without independent evidence"
  ],
  "owners": {
    "public_status_and_consent": "StegVerse-Labs/Site#113",
    "document_privacy_zone": "StegVerse-Labs/Site#116",
    "model_facing_boundary": "StegVerse-org/LLM-adapter#90",
    "credential_and_linkage_capability": "StegVerse-Labs/TVC",
    "custody_and_reconstruction": "master-records/orchestration"
  },
  "canonical_handoff": "docs/VA_PII_REDACTION_CREDENTIAL_REALIGNMENT_MIRROR_HANDOFF.md",
  "canonical_issue": "StegVerse-Labs/Site#116"
}
