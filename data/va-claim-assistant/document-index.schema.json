{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/va-claim-assistant/document-index.schema.json",
  "title": "VA Claim Assistant Document Evidence Index",
  "type": "object",
  "required": ["schema_version", "session_id", "documents", "authority_flags"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "source_identity", "sha256", "page_count", "privacy_class", "condition_associations", "extraction_status", "retention_status", "custody_reference"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "source_identity": {
            "type": "object",
            "required": ["kind", "label"],
            "properties": {
              "kind": {"enum": ["VA_RECORD", "SERVICE_RECORD", "PRIVATE_MEDICAL", "VA_DECISION", "LAY_STATEMENT", "EMPLOYMENT_RECORD", "OTHER"]},
              "label": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "page_count": {"type": "integer", "minimum": 1},
          "page_anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["anchor_id", "page", "section"],
              "properties": {
                "anchor_id": {"type": "string", "minLength": 1},
                "page": {"type": "integer", "minimum": 1},
                "section": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "privacy_class": {"enum": ["PUBLIC", "PERSONAL", "SENSITIVE_HEALTH", "HIGHLY_SENSITIVE"]},
          "condition_associations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "extraction_status": {"enum": ["NOT_STARTED", "COMPLETE", "PARTIAL", "FAILED"]},
          "retention_status": {"enum": ["EPHEMERAL", "RETAINED_BY_USER", "CUSTODY_RECORDED", "DELETED"]},
          "custody_reference": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "authority_flags": {
      "type": "object",
      "required": ["adjudication", "representation", "medical_opinion", "rating", "execution", "publication"],
      "properties": {
        "adjudication": {"const": false},
        "representation": {"const": false},
        "medical_opinion": {"const": false},
        "rating": {"const": false},
        "execution": {"const": false},
        "publication": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
