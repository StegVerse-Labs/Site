{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/va/pii-redaction-working-copy-evidence.schema.json",
  "title": "VA PII Redaction and Pseudonymous Working-Copy Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "runtime_class",
    "processor_path",
    "processor_commit_sha",
    "execution_class",
    "original_document_sha256",
    "redacted_document_sha256",
    "redaction_manifest_sha256",
    "pseudonymous_document_token",
    "direct_identifier_replacement_count",
    "page_region_anchors_present",
    "manifest_bound_to_original_and_redacted_hashes",
    "token_is_purpose_limited",
    "token_is_non_global",
    "raw_document_left_privacy_zone",
    "raw_pii_present_in_working_copy",
    "model_release_allowed",
    "private_document_upload_enabled",
    "custody_reference",
    "authority_effect",
    "activation_effect",
    "state"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"const": "PII-RDY-02"},
    "runtime_class": {"const": "ADMITTED_PRIVATE_DOCUMENT_PREPROCESSOR"},
    "processor_path": {"type": "string", "minLength": 1},
    "processor_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_class": {"enum": ["PRODUCTION", "CONTROLLED_PRODUCTION_EQUIVALENT"]},
    "original_document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "redacted_document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "redaction_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pseudonymous_document_token": {"type": "string", "minLength": 16},
    "direct_identifier_replacement_count": {"type": "integer", "minimum": 1},
    "page_region_anchors_present": {"const": true},
    "manifest_bound_to_original_and_redacted_hashes": {"const": true},
    "token_is_purpose_limited": {"const": true},
    "token_is_non_global": {"const": true},
    "raw_document_left_privacy_zone": {"const": false},
    "raw_pii_present_in_working_copy": {"const": false},
    "model_release_allowed": {"const": true},
    "private_document_upload_enabled": {"const": false},
    "custody_reference": {"type": "string", "minLength": 1},
    "authority_effect": {"const": false},
    "activation_effect": {"const": false},
    "state": {"const": "PASS"}
  }
}
