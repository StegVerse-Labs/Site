{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/va-claim-assistant/document-evidence-assessment.schema.json",
  "title": "VA Claim Assistant Document Evidence Assessment",
  "type": "object",
  "required": ["schema_version", "session_id", "facts", "inferences", "contradictions", "missing_evidence", "authority_flags", "assessment_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "text", "posture", "document_id", "page", "anchor_id"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "posture": {"enum": ["FAVORABLE", "UNFAVORABLE", "NEUTRAL", "CONFLICTING"]},
          "document_id": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "anchor_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["inference_id", "text", "supported_by", "confidence", "requires_verification"],
        "properties": {
          "inference_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "supported_by": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "requires_verification": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contradiction_id", "fact_ids", "description", "resolution_state"],
        "properties": {
          "contradiction_id": {"type": "string", "minLength": 1},
          "fact_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "description": {"type": "string", "minLength": 1},
          "resolution_state": {"enum": ["UNRESOLVED", "EXPLAINED", "RESOLVED"]}
        },
        "additionalProperties": false
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["missing_id", "category", "description", "materiality", "next_action"],
        "properties": {
          "missing_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["CURRENT_DISABILITY", "IN_SERVICE_EVENT", "NEXUS", "SEVERITY", "CONTINUITY", "LAY_EVIDENCE", "OTHER"]},
          "description": {"type": "string", "minLength": 1},
          "materiality": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "next_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "authority_flags": {
      "type": "object",
      "required": ["adjudication", "representation", "medical_opinion", "rating", "execution", "publication"],
      "properties": {
        "adjudication": {"const": false},
        "representation": {"const": false},
        "medical_opinion": {"const": false},
        "rating": {"const": false},
        "execution": {"const": false},
        "publication": {"const": false}
      },
      "additionalProperties": false
    },
    "assessment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
