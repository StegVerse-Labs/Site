{
  "schema": "stegverse.site.cloudflare_steggate_credential_profile.v1",
  "goal_id": "STEGGATE-STABLE-RENDEZVOUS-HARDENING",
  "consumer": {
    "organization": "StegVerse-Labs",
    "repository": "Site",
    "workflow": "steggate-rendezvous-deploy.yml",
    "branch": "main"
  },
  "authentication": {
    "preferred_method": "account_api_token",
    "api_token_environment_variable": "CLOUDFLARE_API_TOKEN",
    "account_id_environment_variable": "CLOUDFLARE_ACCOUNT_ID",
    "legacy_global_api_key_required": false,
    "legacy_email_required": false,
    "raw_credentials_may_be_persisted": false
  },
  "cloudflare_dashboard_path": "Manage account -> Account API tokens -> Create Token -> Custom -> Edit Cloudflare Workers",
  "resource_scope": {
    "account": "the Cloudflare account containing stegverse.org",
    "zone": "stegverse.org",
    "scope_rule": "restrict the token to the minimum account and zone resources required for this Worker deployment"
  },
  "required_capabilities": [
    "Workers Scripts Write",
    "Workers Routes Write"
  ],
  "runtime_validation": {
    "probe": "GET /client/v4/accounts/{account_id}/workers/scripts",
    "accepted_when": "HTTP 2xx and Cloudflare response success=true",
    "records_secret_value": false,
    "failure_state": "FAIL_CLOSED_CREDENTIAL_INVALID_OR_SCOPE_INSUFFICIENT"
  },
  "authority": {
    "credential_value_creation_authority": false,
    "credential_read_authority": "TVC-bound execution-environment read only",
    "deployment_authority": "bounded to StegGate rendezvous Worker after TVC and runtime credential validation",
    "steggate_policy_authority": false
  },
  "status": "IMPLEMENTED_AWAITING_RUNTIME_VALUE_PRESENCE"
}
